// これを Secrets.xcconfig という名前で写して書き換える（Secrets.xcconfig はコミットしない）。
// キーはアプリに入るので、ビルドしたアプリを人に渡さないこと。
// xcconfig では「//」から後ろがコメントになるので、値に // を含めないこと。

SHELFSIGHT_TEAM_ID = ABCDE12345
// App Store Connect で登録したバンドル ID（既定は jp.devfest.shelfsight）
// SHELFSIGHT_BUNDLE_ID = jp.example.shelfsight

GEMINI_API_KEY = ここに Gemini の API キー
GCP_API_KEY = ここに Cloud Vision の API キー
// 店の地図のバックエンドの鍵（任意）
BACKEND_API_KEY = ここにバックエンドの鍵
